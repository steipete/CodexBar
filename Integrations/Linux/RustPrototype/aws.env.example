# Replace vault, item and field names with your existing 1Password AWS item.
# These are references, never credential values. Pass this file to op run.
AWS_ACCESS_KEY_ID=op://VAULT/AWS-ITEM/access key id
AWS_SECRET_ACCESS_KEY=op://VAULT/AWS-ITEM/secret access key
# If the item holds temporary credentials, also reference its session token:
# AWS_SESSION_TOKEN=op://VAULT/AWS-ITEM/session token
